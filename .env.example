# ==============================================================================
# NOMIX ROLEPLAY - WEB APPLICATION ENVIRONMENT VARIABLES
# ==============================================================================

# Supabase Public Configuration (Exposed to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Private Admin (Server-side ONLY - Never expose to client!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Discord OAuth Credentials
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# Server & FiveM Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_NAME="NOMIX Roleplay"
NEXT_PUBLIC_SERVER_SLOGAN="YOUR CITY. YOUR STORY. YOUR LEGACY."
NEXT_PUBLIC_DISCORD_INVITE_URL="https://discord.gg/zDZNZT2RKq"
NEXT_PUBLIC_FIVEM_CONNECT_URL="fivem://connect/play.nomixrp.com"

# FiveM Live Telemetry Configuration:
# Option A: FiveM Server IP & Port (e.g. 123.45.67.89 or play.nomixrp.com)
NEXT_PUBLIC_SERVER_IP="play.nomixrp.com"
NEXT_PUBLIC_SERVER_PORT="30120"

# Option B: Cfx.re Join Code (e.g. from cfx.re/join/xxxxxx or your txAdmin cfx link)
NEXT_PUBLIC_FIVEM_CFX_CODE=""

# Reapplication Cooldown in days
REAPPLICATION_COOLDOWN_DAYS=3
