# ==============================================================================
# NOMIX ROLEPLAY - WEB APPLICATION ENVIRONMENT VARIABLES
# ==============================================================================

# Supabase Public Configuration (Exposed to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Private Admin (Server-side ONLY - Never expose to client!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Discord OAuth Credentials (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# Server & FiveM Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_NAME="NOMIX Roleplay"
NEXT_PUBLIC_SERVER_SLOGAN="YOUR CITY. YOUR STORY. YOUR LEGACY."
NEXT_PUBLIC_DISCORD_INVITE_URL="https://discord.gg/zDZNZT2RKq"
NEXT_PUBLIC_FIVEM_CONNECT_URL="fivem://connect/play.nomixroleplay.xyz"

# FiveM Live Telemetry Configuration:
NEXT_PUBLIC_SERVER_IP="play.nomixroleplay.xyz"
NEXT_PUBLIC_SERVER_PORT="30120"
NEXT_PUBLIC_FIVEM_CFX_CODE=""

# Reapplication Cooldown in days
REAPPLICATION_COOLDOWN_DAYS=3

# ==============================================================================
# DISCORD BOT & AUTOMATED CHANNEL / ROLE NOTIFICATIONS
# ==============================================================================
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_GUILD_ID=your-discord-guild-id

# Visa Application Channels:
DISCORD_APPLICATION_CHANNEL_ID=your-incoming-apps-channel-id
DISCORD_REVIEW_CHANNEL_ID=your-review-action-channel-id
DISCORD_APPROVED_CHANNEL_ID=your-approved-announcements-channel-id
DISCORD_REJECTED_CHANNEL_ID=your-rejected-channel-id
DISCORD_VERIFIED_ROLE_ID=your-citizen-role-id

# Supporter Packages & Donations Channels:
# 1. New Orders Channel (Admin/Staff only — receives notification when order is placed):
DISCORD_NEW_ORDERS_CHANNEL_ID=your-new-orders-channel-id
DISCORD_NEW_ORDERS_WEBHOOK_URL=

# 2. Donations Channel (Community/Public — tags & pings user when admin delivers/approves):
DISCORD_DONATIONS_CHANNEL_ID=your-donations-channel-id
DISCORD_DONATIONS_WEBHOOK_URL=

# Supporter Discord Tier Role IDs (Auto-assigned upon admin delivery):
DISCORD_BRONZE_ROLE_ID=your-bronze-role-id
DISCORD_SILVER_ROLE_ID=your-silver-role-id
DISCORD_GOLD_ROLE_ID=your-gold-role-id
DISCORD_PLATINUM_ROLE_ID=your-platinum-role-id
DISCORD_EMERALD_ROLE_ID=your-emerald-role-id
